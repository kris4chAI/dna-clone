# FlyHigh Navigator settings. Copy to .env and edit; docker compose reads it automatically.
# Everything is optional: with no .env the app runs fully, with the LLM features in prompt mode.

# ---------------------------------------------------------------------------
# LLM of choice: the only thing you are likely to set
# ---------------------------------------------------------------------------
# anthropic | openai | azure | gemini | openai_compatible   (leave blank to auto-detect from the key)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional model / deployment name. Defaults: anthropic claude-sonnet-4-5 · openai gpt-4o-mini · gemini gemini-2.0-flash
LLM_MODEL=
# azure: https://<resource>.openai.azure.com   ·   openai_compatible (e.g. Ollama): http://host.docker.internal:11434/v1
LLM_BASE_URL=
AZURE_OPENAI_API_VERSION=2024-06-01
# Let the chat guide rephrase answers with the LLM (true/false)
CHAT_USE_LLM=true

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
FLYHIGH_PORT=8080
POSTGRES_PASSWORD=flyhigh
# true = reload all seed content on the next start (drops curated edits). Set back to false afterwards.
RESET_DB=false

# ---------------------------------------------------------------------------
# Snowflake DEV account for "Execute on Snowflake" in the skills studio (optional)
# Put the private key in ./secrets (mounted read-only at /srv/secrets).
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_PRIVATE_KEY_FILE=/srv/secrets/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ALLOW_EXECUTE=false

# ---------------------------------------------------------------------------
# TAF data checks (assurance workbench > Execution > Data checks run)
# Simulator needs nothing. Snowflake uses the account above (SNOWFLAKE_ALLOW_EXECUTE=true).
# Databricks submits the TAF notebook chain as a one-time job and reads the UC report views.
# Leave a value blank (or as a __PLACEHOLDER__) to use the dev default.
# ---------------------------------------------------------------------------
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
APP_TAF_ENVIRONMENT=            # dev | tst | stg | prd; otherwise detected from the host or credential name
APP_TAF_CATALOG=                # default taf_<env>
APP_TAF_CATALOG_PREFIX=taf
APP_TAF_SCHEMA=raw
APP_TAF_HTTP_PATH=              # SQL warehouse; auto-discovered when blank
APP_TAF_NOTEBOOK_DIR=/Workspace/Shared/taf/files/notebooks/taf/notebooks
APP_TAF_LOG_DIR=                # default /Volumes/<catalog>/<schema>/taf_uploads/logs
APP_TAF_RUN_AS_SP=              # service principal application id for job runs
APP_TAF_MASS_FAIL_PCT=25        # health scenario threshold
APP_TAF_STRANDED_HOURS=12       # Running manifests older than this are closed as Error
APP_UC_CREDENTIAL_NAME=
TAF_SCENARIOS_FILE=             # optional JSON of extra read-only health scenarios

# ---------------------------------------------------------------------------
# Assurance settings (Settings > Connections)
# Connection credentials are encrypted with this Fernet key before they are stored.
# Blank: use secrets/settings.key if present, else a key generated once in the appdata volume.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
SETTINGS_SECRET_KEY=
